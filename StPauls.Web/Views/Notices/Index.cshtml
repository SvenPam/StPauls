@model IEnumerable<sites.Notice>

@{
	ViewBag.Title = "Notices";
}
@section meta
    {
	<title>@ViewBag.Title</title>
	<meta name="description" content="Latest bulletins and notices for St. Pauls Church, Warton." />
}
<div class="container">
	<h1>Notices</h1>
	@if (User.IsInRole("Contributor") || User.IsInRole("Admin"))
			{
		<div class="col-xs-12">
			<span class=" glyphicon glyphicon-list"></span> <a href="@Url.ActionDomain("List", "Notices")">Manage Notices</a>|
			<span class="glyphicon glyphicon-plus"></span> <a href="@Url.ActionDomain("Create", "Notices")">Create a new notice</a>
			<br/>
			<br />
		</div>
			}
	@if (Model.Any())
	{
		foreach (Notice notice in Model)
		{
			<div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
				<div class="panel panel-default">
					<div class="panel-heading panel-heading-link" onclick="window.location.pathname = '@Url.ActionDomain("Notice", "Notices", new { id = notice.NoticeID, slug = notice.URLSlug })'">
						<h3>@notice.Title</h3>
					</div>
					<div class="panel-body">
						<div class="col-xs-12">@notice.Description</div>
					</div>
				</div>
			</div>
		}
	}
	else
	{
		<p>Could not find any notices.</p>
	}
</div>