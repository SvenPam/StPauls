@using Microsoft.AspNet.Identity

<ul class="nav navbar-nav navbar-right">
	@if (Request.IsAuthenticated)
	{

		@Html.AntiForgeryToken()
		<li class="dropdown">
			<a href="#" class="dropdown-toggle nav-to-account" data-toggle="dropdown">@User.Identity.GetUserName()<span class="caret"></span></a>
			<ul class="dropdown-menu" role="menu">
				<li>
					<a href="@Url.ActionDomain("Manage", "Account", routeValues: null)">Manage Your Account</a>
				</li>
				@if (User.IsInRole("Admin"))
				{
					<li>
						<a href="@Url.ActionDomain("Index", "Management", routeValues: null)">Manage Site</a>
					</li>
				}
				<li>
					<a href="javascript:document.getElementById('logoutForm').submit()">Log off</a>
					@using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", }))
					{
						@Html.AntiForgeryToken()
					}
				</li>
			</ul>
		</li>
	}
	else
	{
		<li><a id="registerLink" href="@Url.ActionDomain("Register", "Account", routeValues: null)">Register</a></li>
		<li><a id="loginLink" href="@Url.ActionDomain("Login", "Account", routeValues: null)">Login</a></li>
	}
</ul>