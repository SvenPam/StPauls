<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "https://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="https://www.w3.org/1999/xhtml">
<head>
	<style type="text/css">
		#outlook a {
			padding: 0;
		}

		a {
			color: #2980b9;
		}

			a:hover {
				color: #2538d4;
				cursor: pointer;
			}

		blockquote {
			border-left: #f1c40f solid 5px;
			padding-left: 8px;
			display: block;
			margin-bottom: 5px;
			border-bottom: none;
		}

		body {
			width: 100% !important;
			-webkit-text-size-adjust: none;
			margin: 0;
			font-family: Arial;
			color: #F8F8F8 !important;
			font-size: 14px;
			background-color: #f0f0f0;
		}

		table td {
			border-collapse: collapse;
		}

		#backgroundTable {
			height: 100% !important;
			width: 100% !important;
			margin: 0;
			padding: 0;
		}

		#templateContainer {
			border: 1px solid #DDD;
		}

		p {
			font-size: 14px;
		}

		h1, .h1 {
			color: #1A1A33 !important;
			display: block;
			font-family: Arial;
			font-size: 30px;
			font-weight: 700;
			line-height: 100%;
			text-align: left;
			margin: 0 0 10px;
		}

		h2, .h2 {
			color: #202020 !important;
			display: block;
			font-family: Arial !important;
			font-size: 20px !important;
			font-weight: 700 !important;
			line-height: 100% !important;
			text-align: left !important;
			margin: 0 0 10px !important;
		}

		h3, .h3 {
			color: #676767 !important;
			font-family: sans-serif !important;
			font-weight: 300 !important;
			font-size: 18px;
		}

		h4, .h4 {
			color: #FFF;
			display: block !important;
			font-family: Arial !important;
			font-size: 12px !important;
			font-weight: 700 !important;
			line-height: 100% !important;
			text-align: center !important;
			margin: 0 0 10px !important;
			padding-top: 10px;
		}

		#templatePreheader {
			background-color: #FAFAFA;
		}

		#templateHeader {
			background-color: #F8F8F8;
			border-bottom: 1px solid #E7E7E7;
		}

		#templateContainer, .bodyContent, .fullWidthBandContent {
			background-color: #FFF;
		}

			.bodyContent div, .fullWidthBandContent div {
				color: #505050;
				font-family: Arial;
				font-size: 12px;
				line-height: 150%;
				text-align: left;
			}

			.bodyContent img, .fullWidthBandContent img {
				display: inline;
				height: auto;
			}

		#templateFooter {
			background-color: #0C0C0E;
		}

		.footerContent div {
			color: #0C0C0E;
			font-family: Arial;
			font-size: 11px;
			line-height: 125%;
			text-align: left;
		}

		.ReadMsgBody, .ExternalClass {
			width: 100%;
		}

		#social div, #utility div {
			text-align: center;
		}
	</style>
</head>
<body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0">
	<center>
		<table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%" id="backgroundTable">
			<tr>
				<td align="center" valign="top">
					<table border="0" cellpadding="0" cellspacing="0" width="600" id="templateContainer">
						<tr>

							<td align="center" valign="top">
								<table border="0" cellpadding="0" cellspacing="0" width="600" id="templateHeader">
									<tr>
										<td class="headerContent" height="40"></td>
									</tr>
								</table>
							</td>
						</tr>
						<tr>
							<td align="center" valign="top">
								<table border="0" cellpadding="0" cellspacing="0" width="600" id="templateBody">
									<tr>
										<td colspan="4" valign="top" class="bodyContent">
											<table border="0" cellpadding="20" cellspacing="0" width="100%">
												<tr>
													<td valign="top">
														<div mc:edit="std_content00">
															@RenderBody()
														</div>
													</td>
												</tr>
											</table>
										</td>
									</tr>
								</table>
							</td>
						</tr>
						<tr>
							<td align="center" valign="top">
								<table border="0" width="600" id="templateFooter">
									<tr>
										<td valign="top" class="footerContent">
											<table border="0" cellpadding="10" cellspacing="0" width="100%">
												<tr>
													<td valign="middle" id="social">
														<div mc:edit="std_footer">
															<a href="http://@Sites.CurrentSite.Domain">St Pauls</a> | <a href="http://@Sites.CurrentSite.Domain/blog">Blog</a> | <a href="http://@Sites.CurrentSite.Domain/calendar">Events</a> | <a href="http://@Sites.CurrentSite.Domain/Notices">Notices</a>
														</div>
													</td>
												</tr>
											</table>
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</center>
</body>
</html>
