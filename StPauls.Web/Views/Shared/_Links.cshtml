<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
	<br />
	<h4>Links</h4>
	<hr>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Index", "blog")">Church Blog</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Index", "Calendar")">Church Calendar</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Index", "Notices")">Church Notices</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Register", "Account")">Register</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Login", "Account")">Login</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Index", "Contact")">Contact Us</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.ActionDomain("Sitemap", "Home")">Site Map</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href="@Url.Action("index", "pages", new {type="about", slug = "privacy-policy" })">Privacy Policy</a>
	</div>
	<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
		<a href=" @Url.Action("index", "pages", new { type = "about", slug = "cookie-policy" }) ">
			Cookie Policy
		</a>
	</div>
	@foreach (sites.Type type in Sites.CurrentSite.Types)
	{
		if (type.Pages.Any())
		{
			<div class="clearfix"></div>
				<h4>@type.Name</h4>
			foreach (sites.Page page in type.Pages.Where(x=> !x.IsHidden))
			{
				<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
					<a href="@Url.Content("~" + page.URL)">@page.Title</a>
				</div>
			}
		}
	}
	<div class="clearfix"></div>
	@if (User.IsInRole("Admin"))
	{
		<h4>Management</h4>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("index", "management")">Management</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("roles", "management")">Manage User Roles</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("types", "management")">Manage Page Types</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("topics", "management")">Manage Topics</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("groups", "management")">Manage Groups</a>
			</div>
			<br />
			<br />
			<br />
			<br />
	}

	@if (User.IsInRole("Contributor"))
	{
		<h4>Contributor</h4>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("create", "page")">Create Page</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("create", "blog")">Create Blog Article</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("create", "calendar")">Create Event</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="@Url.ActionDomain("create", "notices")">Create Notice</a>
			</div>
			<div class="col-lg-6 col-md-12 col-sm-12 col-xs-12">
				<a href="/fileman/index.html" >File Manager</a>
			</div>
			<br />
			<br />
			<br />
	}
</div>
<div class="col-md-6 col-xs-12">
	<br />
	<h4>Find Us</h4>
	<hr />
	<div class="col-xs-12 hidden-xs">
		<a href="https://www.google.co.uk/maps/place/Parish+Church+of+Saint+Paul+Warton/53.7513578,-2.8932638,16.25z/data=!4m2!3m1!1s0x487b6a5be3b39591:0x9e22ee85558d2d1d">
			<img src="~/Areas/st_pauls/Content/Image/map.png" width="100%" />
		</a>
		<br />
		<br />
	</div>
	<div class="col-sm-6 col-xs-12">
		<h4>Address</h4>
		<a href="http://maps.google.com/?saddr=Current+Location&daddr=53.7513578,-2.8932638">
			<address class="small">
				Church Road,
				<br />
				Warton,
				<br />
				Lancashire,
				<br />
				PR4 1BD
			</address>
		</a>
		<br />
	</div>
	<div class="col-sm-6 col-xs-12">
		<h4>Social</h4>
		<ul class="social large">
			<li>
				<a class="social-icon large follow facebook" href="https://www.facebook.com/stpaulswarton" target="_blank" title="Follow Us On Facebook">
					Like Us On Facebook
				</a>
			</li>
		</ul>
		<br />
	</div>
</div>


