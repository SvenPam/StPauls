@section Meta
{
    <title>Not Found</title>
    <meta name="description" content="The page you're looking for, could not be found." />
    <meta property="og:title" content="Not Found" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content="The page you're looking for, could not be found." />
    @*<meta property="og:image" content="@Url.Content("~/Areas/t2t2015/Content/Image/c2c.jpg")" />*@
}

<div class="container">
    <h1>Page Not Found</h1>
    <h4>We're sorry but we couldn't find that page.</h4>
    <hr />
    <div class="container">
        <div class="row">
            <p>This could be because:</p>
            <ul>
                <li>You mis-typed the URL.</li>
                <li>You clicked a bad or out of date link.</li>
            </ul>
            <p>Try one of the links in the header or footer to get back.</p>
            <br />
            <script type="text/javascript">
                var GOOG_FIXURL_LANG = 'en';
                var GOOG_FIXURL_SITE = 'http://stpaulswarton.co.uk'
            </script>
            <script type="text/javascript"
                    src="http://linkhelp.clients.google.com/tbproxy/lh/wm/fixurl.js">
            </script>
        </div>
    </div>
</div>