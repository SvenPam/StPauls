@model sites.Event
@using System.Globalization
@{
	Layout = "~/Areas/St_Pauls/Views/Shared/_LayoutWide.cshtml";
	ViewBag.Title = Model.Title;
	string titleWidth = @Model.EndDate.HasValue ? "6" : "9";
	TimeSpan toGo = Model.StartDate - sites.Helpers.UKDateTime.Now;
}

@if (toGo.Hours < 0)
{
	if (sites.Helpers.UKDateTime.Now < Model.EndDate)
	{
		toGo = new TimeSpan(-1, 0, 0);
	}
}
@section meta
{
	<title>@ViewBag.Title</title>
	<meta name="description" content="@Model.Description" />
}
<div class="container">
	<div class="jumbotron">
		<div class="container">
			<div class="col-xs-12">
				<div class="row">
					<div class="col-md-@titleWidth col-sm-12">
						<h2>@Model.Title</h2>
						<p>@Model.Creator.FirstName @Model.Creator.Surname </p> <p class="text-muted">@Model.Topic.Name</p>

						@switch (Model.Status)
						{
							case EventStatus.Expired:
								<div class="alert alert-default" role="alert">
									<p><small>Expired</small></p>
								</div>
								break;
							case EventStatus.Active:
								<div class="alert alert-success" role="alert">
									<p><small>In Progress</small></p>
								</div>
								break;
							case EventStatus.Soon:
								<div class="alert alert-warning" role="alert">
									<p>
										<small>
											@if (toGo.Hours != 0)
											{
												<text>@toGo.Hours hours to go</text>
											}
											else
											{
												<text>@toGo.Minutes minutes to go</text>
											}
										</small>
									</p>
								</div>
								break;
							default:
								<div class="alert alert-info" role="alert">
									<p><small>@toGo.Days days to go</small></p>
								</div>
								break;
						}
						@if (Model.IncludeSocial)
			{
							<ul class="social large">
								<li>
									<a class="social-icon large share facebook" href="https://www.facebook.com/sharer/sharer.php?u=@Request.RawUrl" target="_blank" title="Share this on Facebook">
										Share this on Facebook
									</a>
								</li>
								<li>
									<a class="social-icon large share twitter" href="https://twitter.com/home?status=@Request.RawUrl" target="_blank" title="Share this on Twitter">
										Share on Twitter
									</a>
								</li>
								<li>
									<a class="social-icon large share google" href="https://plus.google.com/share?url=@Request.RawUrl" target="_blank" title="Share this on Google+">
										Share on Google+
									</a>
								</li>
								<li>
									<a class="social-icon large share linkedin" href="https://www.linkedin.com/shareArticle?mini=true&amp;url=@Request.RawUrl" target="_blank" title="Share this on LinkedIn">
										Share on LinkedIn
									</a>
								</li>
							</ul>
			}
						@if (User.IsInRole("Contributor") || User.IsInRole("Admin"))
						{
							<p>
								<a href="@Url.ActionDomain("Edit", "Calendar", new { id = Model.EventID })">Edit</a> |
								<a href="@Url.ActionDomain("Delete", "Calendar", new { id = Model.EventID })">Delete</a>
							</p>
						}
					</div>
					@if (Model.EndDate.HasValue && Model.StartDate.Day == Model.EndDate.Value.Day)
					{
						<div class="col-md-3 col-sm-6 col-xs-12">
							<h1><small>Start</small><br />@Model.StartDate.ToShortTimeString()</h1>
							<p>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.StartDate.Month)</p>
							<h3>@Model.StartDate.Day</h3>
						</div>
						<div class="col-md-3 col-sm-6 col-xs-12">
							<h1><small>End</small><br />@Model.EndDate.Value.ToShortTimeString()</h1>
							<p>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.EndDate.Value.Month)</p>
							<h3>@Model.EndDate.Value.Day</h3>
						</div>
					}
					else
					{
						<div class="col-md-3 col-sm-6 col-xs-12">
							<h1><small>Start</small><br />@Model.StartDate.Day</h1>
							<p>@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(Model.StartDate.Month)</p>
							<span class="glyphicon glyphicon-time"></span> @Model.StartDate.ToShortTimeString()
						</div>
						if (Model.EndDate.HasValue)
						{
							<div class="col-md-3 col-sm-6 col-xs-12">
								<h1><small>End</small><br />@Model.EndDate.Value.Day</h1>
								<p>@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(Model.EndDate.Value.Month)</p>
								<span class="glyphicon glyphicon-time"></span> @Model.EndDate.Value.ToShortTimeString()
							</div>
						}
					}
				</div>
			</div>
		</div>
	</div>

	<div style="margin-top: -30px;" class="bg-default">
		<div class="col-xs-12">
			<h4 class="lead">@Model.Description</h4>
			<br />
			@Html.Raw(Model.HTML)
		</div>
		<br />
		<br />
		@if (Model.IncludeComments)
		{
			<div class="col-xs-12">
				<div id="disqus_thread"></div>
				<script type="text/javascript">
					var disqus_shortname = 'stpaulswarton';
					var disqus_identifier = 'event-@Model.EventID';
					var disqus_title = '@Model.Title';
					var disqus_url = 'http://@Sites.CurrentSite.Domain/calendar/event/@Model.EventID/@Model.URLSlug';
					(function () {
						var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
						dsq.src = '//' + disqus_shortname + '.disqus.com/embed.js';
						(document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
					})();
				</script>
			</div>
		}
	</div>
</div>