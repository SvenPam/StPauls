@model IEnumerable<Event>
@using System.Globalization

@{
	ViewBag.Title = "Calendar";
}
@section meta
{
	<title>@ViewBag.Title</title>
	<meta name="description" content="Read the latest events and going's on at St Pauls Church, Warton." />
}
<div class="container">
	<h1 class="page-header">Upcoming Events</h1>

	@if (User.IsInRole("Contributor") || User.IsInRole("Admin"))
			{
		<span class="glyphicon glyphicon-list"></span> <a href="@Url.ActionDomain("List", "Calendar")">Manage Events</a> @("|")
		<span class="glyphicon glyphicon-plus"></span> <a href="@Url.ActionDomain("Create", "Calendar")">Create a new event</a>
		<br />
		<br />
			}
	<div id="calendar-index">
		@if (Model.Any())
		{
			foreach (Event oneEvent in Model)
			{
				<div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
					<div class="panel panel-default event-panel">
						<div class="panel-heading panel-heading-link" onclick="window.location.pathname = '@Url.ActionDomain("Event", "Calendar", new { id = oneEvent.EventID, slug = oneEvent.URLSlug })'">
							<div class="row">
								<div class="col-xs-6">
									<h1>@oneEvent.StartDate.Day</h1>
									@switch (oneEvent.Status)
									{
										case EventStatus.Expired:
											<span class="label label-default">Expired</span>
											break;
										case EventStatus.Active:
											<span class="label label-success">In Progress</span>
											break;
										case EventStatus.Soon:
											<span class="label label-warning">Soon</span>
											break;
									}
								</div>
								<div class="col-xs-6"><span class="glyphicon glyphicon-time"></span> @oneEvent.StartDate.ToString("HH:mm") <p>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(oneEvent.StartDate.Month)</p></div>
							</div>
						</div>
						<div class="panel-body event-info">
							<div class="col-xs-12">
								<h3>@oneEvent.Title</h3>
								<address>
									@oneEvent.Location
								</address>
							</div>
							<div class="col-xs-12">@oneEvent.Description</div>
						</div>
					</div>
				</div>
			}
		}
		else
		{
			<p>Could not find any events.</p>
		}
	</div>
</div>