@model sites.Page

@{
	ViewBag.Title = "Page";
	string mainLayout = Model.WideLayout ? "~/Areas/St_Pauls/Views/Shared/_LayoutWide.cshtml" : "~/Areas/St_Pauls/Views/Shared/_Layout.cshtml";
	Layout = mainLayout;
}

@section meta
{
	<title>@Model.Title</title>
	<meta name="description" content="@Model.Description" />
	@if (Model.IncludeSocial)
	{
	}
}
<div class="container">
	@if (User.IsInRole("Contributor") || User.IsInRole("Admin"))
	{
		<p>
			<a href="@Url.ActionDomain("Edit", "Pages", new { id = Model.PageID })">Edit</a>
			| <a href="@Url.ActionDomain("Delete", "Pages", new { id = Model.PageID })">Delete</a>
		</p>
	}
	<div class="col-xs-12">
		<h1 class="page-header">@Model.Title</h1>
		<br />
		@if (Model.IncludeSocial)
		{

		}
		@Html.Raw(Model.HTML)
		<br />
		<br />
	</div>
	@if (Model.IncludeComments)
	{
		<div class="col-xs-12">
			<div id="disqus_thread"></div>
			<script type="text/javascript">
				var disqus_shortname = 'stpaulswarton';
				var disqus_identifier = 'page-@Model.PageID';
				var disqus_title = '@Model.Title';
				var disqus_url = 'http://@Sites.CurrentSite.Domain/page/@Model.Type.URLSlug/@Model.URLSlug';
				(function () {
					var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
					dsq.src = '//' + disqus_shortname + '.disqus.com/embed.js';
					(document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
				})();
			</script>
		</div>
	}
</div>