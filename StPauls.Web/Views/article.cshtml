@inherits Umbraco.Web.Mvc.UmbracoViewPage<BlogArticle>
@{
    Layout = "Layout.cshtml";
}
<div class="row">
    <div class="col-md-8 col-xs-12">
        <article itemscope itemtype="http://schema.org/BlogPosting">
            <h1 itemprop="headline" class="page-header">
                @Model.Title
            </h1>
            <p>
                <span class="glyphicon glyphicon-time"></span> Published <span itemprop="datePublished" content="@Model.CreateDate.ToIsoString()">@Model.FormattedDate</span> <span class="glyphicon glyphicon-bookmark padding-sides"></span> <a>@Model.Topic</a>
                @*@if (User.IsInRole("Contributor") || User.IsInRole("Admin"))
                    {
                        <span style="padding-left: 30px;" class="glyphicon glyphicon-pencil"></span>
                        <a href="@Url.ActionDomain("Edit", "Blog", new { id= Model.ArticleID })">Edit</a>
                        <span style="padding-left: 30px;" class="glyphicon glyphicon-trash"></span>
                        <a href="@Url.ActionDomain("Delete", "Blog", new { id= Model.ArticleID })">Delete</a>
                    }*@
                @if (Model.IncludeSocial)
                {
                    <br /><br />
                    <ul class="social large">
                        <li>
                            <a class="social-icon large share facebook" href="https://www.facebook.com/sharer/sharer.php?u=@Model.Url" target="_blank" title="Share this on Facebook">
                                Share this on Facebook
                            </a>
                        </li>
                        <li>
                            <a class="social-icon large share twitter" href="https://twitter.com/home?status=@Model.Url" target="_blank" title="Share this on Twitter">
                                Share on Twitter
                            </a>
                        </li>
                        <li>
                            <a class="social-icon large share google" href="https://plus.google.com/share?url=@Model.Url" target="_blank" title="Share this on Google+">
                                Share on Google+
                            </a>
                        </li>
                        <li>
                            <a class="social-icon large share linkedin" href="https://www.linkedin.com/shareArticle?mini=true&amp;url=@Model.Url" target="_blank" title="Share this on LinkedIn">
                                Share on LinkedIn
                            </a>
                        </li>
                    </ul>
                }
            </p>
            <h2 class="author-attribution">
                <small itemscope itemtype="http://schema.org/Person">by <span itemprop="name">@Model.CreatorName</span></small>
            </h2>
            <div itemprop="articleBody">
                @Html.GetGridHtml(Model, "content")
            </div>
            <br />
            <br />
        </article>
        <div class="col-xs-12">
            <div id="disqus_thread"></div>
            <script type="text/javascript">
				var disqus_shortname = 'stpaulswarton';
				var disqus_identifier = 'article-@Model.Id';
				var disqus_title = '@Model.Title';
				var disqus_url = '@Model.Url';
				(function () {
					var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
					dsq.src = '//' + disqus_shortname + '.disqus.com/embed.js';
					(document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
				})();
            </script>
        </div>
    </div>
    <div class="col-md-4 hidden-sm hidden-xs">
        @Html.Partial("~/Views/Partials/_Aside.cshtml")
    </div>
</div>