@inherits Umbraco.Web.Macros.PartialViewMacroPage
@{
    var latestNotices = this.Umbraco.ContentAtRoot().DescendantsOrSelf<Notice>().OrderByDescending(x => x.CreateDate);

}

@if (latestNotices.Any())
{
    <section class="spacer">
        <h2><a href="/notices)">Church Notices</a></h2>
        @foreach (var notice in latestNotices)
        {
            <a class="home-page-notice" href="@notice.Url">
                <h3>@notice.Name</h3>
                <p>@notice.BulletinBody</p>
            </a>
        }
    </section>
}