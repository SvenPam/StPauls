@inherits Umbraco.Web.Macros.PartialViewMacroPage
@{
    var latestEvents = this.Umbraco.ContentAtRoot().DescendantsOrSelf<Event>().Where(x => x.Status != EventStatus.Expired).Take(20);
}

@if (latestEvents.Any())
{
    <section class="spacer">
        <h2><a href="/calendar">Upcoming Events</a></h2>
        @foreach (var month in latestEvents.GroupBy(x => x.StartDate.ToString("MMM")))
        {
        <div>
            <h3>@month.Key</h3>
            <ul>
                @foreach (var evnt in month)
                {
                    <li style="margin-bottom:10px;">
                        <strong>@evnt.StartDate.Day</strong>
                        <a href="@evnt.Url">
                            @evnt.Name
                        </a>
                        @if (evnt.Status == EventStatus.Soon || evnt.Status == EventStatus.Active)
                        {
                            <span class="label label-@evnt.EventStatusBootstrapColourClass">
                                @evnt.Status
                            </span>
                        }
                    </li>
                }
            </ul>
        </div>
        }
    </section>
}
