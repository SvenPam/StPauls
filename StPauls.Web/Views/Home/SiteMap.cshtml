@model sites.Models.SiteMapViewModel
@{
	ViewBag.Title = "St. Pauls Church Site Map";
}
@section meta
{
	<title>Site Map</title>
}
<div class="container">
	<h1>Site Map</h1>

	@foreach (var group in Model.SiteMapNode.Children.OrderBy(x => x.Title).Where(x => x.Depth == 1))
	{
		<h3>
			@if (string.IsNullOrEmpty(group.URL))
			{
				@group.Title
			}
			else
			{
				<a href="@group.URL">@group.Title</a>
			}
		</h3>
		<ul>
			@foreach (var node in group.Children.OrderBy(x => x.Title))
			{
				<li>
					@if (node.URL == "")
					{

						<span>@node.Title</span>
					}
					else
					{
						<a href="@node.URL">@node.Title</a>
					}
					<ul>
						@foreach (var child in node.Children)
						{
							<li>
								<a href="@child.URL">@child.Title</a>
							</li>
						}
					</ul>
				</li>
			}
		</ul>
	}



