@model sites.Models.HomePageViewModel
@{
	Layout = "~/Areas/St_Pauls/Views/Shared/_LayoutNoBackground.cshtml";
	ViewBag.Title = Sites.CurrentSite.SiteName;
}

@section meta
{
	<title>@ViewBag.Title</title>
	<meta name="description" content="St. Pauls's Church, Warton. Serving Christ - Serving the Community.">
	<meta property="og:description" content="St. Pauls's Church, Warton. Serving Christ - Serving the Community." />
	<meta property="og:type" content="website" />
	<meta property="og:image" content="http://stpaulswarton.co.uk/Areas/St_Pauls/Content/Image/PAGE-BACK.JPG" />

}
<div class="container-fluid">
	<div class="row">
		<div class="jumbotron home-page-hero">
			<div class="container">
				<h1>@Sites.CurrentSite.SiteName</h1>
				<p class="lead">Serving Christ - Serving the Community</p>
			</div>
		</div>
	</div>
</div>
<div class="container">
	<div class="col-md-9">
		@if (Model.LatestNotices.Any())
		{
			<h3><a href="@Url.Action("Index", "Notices")">Church Notices</a></h3>
			foreach (Notice notice in Model.LatestNotices)
			{
				<a class="home-page-notice" href="@Url.ActionDomain("Notice", "Notices", new { id = notice.NoticeID, slug = notice.URLSlug })">
					<h3>@notice.Title</h3>
					<p>@notice.Description</p>
				</a>
			}
		}
	</div>
	<div class="col-md-3">
		@if (Model.LatestEvents.Any())
		{
			<h3><a href="@Url.Action("Index", "Calendar")">Upcoming Events</a></h3>
			foreach (var month in Model.LatestEvents)
			{
				<div>
					<h3>@month.Key</h3>
					@foreach (var evnt in month)
					{
						<div>
							<a href="@evnt.URL">
								<strong>@evnt.StartDate.Day</strong> @evnt.Title
								@if (evnt.Status == EventStatus.Soon || evnt.Status == EventStatus.Active)
								{
									<span class="label @(evnt.Status == EventStatus.Soon ? "label-warning" : "label-success")">
										@evnt.Status
									</span>
								}
							</a>
						</div>
					}
				</div>
			}
		}
	</div>
	<div class="spacer"></div>
	<div class="col-xs-12">
		<h3><a href="@Url.Action("Index", "Blog")">Latest Blog Articles</a></h3>
	</div>
	@foreach (var article in Model.LatestBlogs.Take(3))
	{
		<div class="col-md-4">
			<div class="thumbnail">
				<img src="@Url.Content(article.Image)?h=300&w=350&mode=crop" />
				<div class="caption">
					<h3>@article.Title</h3>
					<p>@article.Description</p>
					<a class="btn btn-default" href="@article.Url">Read →</a>
				</div>
			</div>
		</div>
	}
</div>