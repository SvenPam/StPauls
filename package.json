    "test:bdd": "cd tests && bddgen && playwright test",
    "audit": "npm audit"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@playwright/test": "1.56.1",
    "clean-css": "5.3.3",
    "entities": "6.0.1",
    "playwright-bdd": "9.2.1",
    "sharp": "0.35.5",
    "terser": "5.51.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "chokidar": "4.0.3",
    "argparse": "2.0.1"
  }
}
