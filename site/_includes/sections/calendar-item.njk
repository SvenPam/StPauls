{#- Live's date blocks: the same wall date reads time, month, day; otherwise day, short month, time, and End only when set. -#}
{%- set data = { date: date, end: end } -%}
{%- set endsAt = data | eventEnd -%}
{%- set ownEnd = data | hasEnd -%}
{%- set sameDay = ownEnd and (date | isoDay) == (endsAt | isoDay) -%}
<article>
  <h1>{{ title }}</h1>
  <p class="countdown" data-start="{{ date | isoLondon }}" data-end="{{ endsAt | isoLondon }}">{{ data | countdown }}</p>
  <div class="meta">
    {%- set topicSlug = topic %}{% set topicSection = section %}
    {%- set topicLink %}{% include "partials/topic-link.njk" %}{% endset %}
    {%- if topicLink | trim %}
    <p class="topic-line">Topic: {{ topicLink | safe }}</p>
    {%- endif %}
  </div>
  <dl class="event-when">
    {%- set whens = [{ label: 'Start', t: date }] %}
    {%- if ownEnd %}{% set whens = (whens.push({ label: 'End', t: endsAt }), whens) %}{% endif %}
    {%- for w in whens %}
    <div>
      <dt>{{ w.label }}</dt>
      <dd><time datetime="{{ w.t | isoLondon }}">
        {%- if sameDay %}<span class="event-time">{{ w.t | time }}</span> <span class="event-month">{{ w.t | month }}</span> <span class="event-day">{{ w.t | day }}</span>
        {%- else %}<span class="event-day">{{ w.t | day }}</span> <span class="event-month">{{ w.t | shortMonth }}</span> <span class="event-time">{{ w.t | time }}</span>{% endif -%}
      </time></dd>
    </div>
    {%- endfor %}
  </dl>
  {%- if location %}
  <address class="event-location">{{ location }}</address>
  {%- endif %}
  {%- if summary %}
  <p class="lead">{{ summary }}</p>
  {%- endif %}
  {% set imageSrc = image %}{% set imageAlt = image_alt %}{% include "partials/image.njk" %}
  <div class="prose">
    {{ content | safe }}
  </div>
  <p><a href="/calendar">Back to the calendar</a></p>
</article>
