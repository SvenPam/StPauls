{#- The home page, from the root _index.md. hero_image is an asset or an /uploads path; with none the default hero shows.
    An empty hero_alt makes the image decorative. -#}
{%- set heroSrc = (hero_image | assetPath) or hero_image or 'images/hero.jpg' %}
<section class="hero">
  {% picture { src: heroSrc, alt: hero_alt or '', sizes: '100vw', eager: true } %}
  <div class="hero__text">
    <h1>{{ title }}</h1>
    {%- if lead %}
    <p class="hero__lead">{{ lead }}</p>
    {%- endif %}
  </div>
</section>

{%- set notices = collections.notices | noticesHome %}
{%- set events = (collections.calendar | upcoming).slice(0, 20) %}
{%- if notices.length or events.length %}
<div class="home-columns{% if notices.length and events.length %} home-columns--two{% endif %}">
{%- if notices.length %}
<section class="home-section" aria-labelledby="home-notices">
  <h2 id="home-notices"><a href="/notices">Church Notices</a></h2>
  <div class="home-notices">
    {%- for item in notices %}
    <a class="home-notice" href="{{ item.url | href }}">
      <h3>{{ item.data.title }}</h3>
      {%- if item.data.summary %}
      <p>{{ item.data.summary }}</p>
      {%- endif %}
    </a>
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- if events.length %}
{#- Live's Upcoming Events column: the next 20, under their month, day in bold, Soon or Active when it applies. #}
<section class="home-section home-events" aria-labelledby="home-events">
  <h2 id="home-events"><a href="/calendar">Upcoming Events</a></h2>
  {%- for group in events | byMonth %}
  <div class="home-events__month">
    <h3>{{ group.month }}</h3>
    <ul>
      {%- for item in group.items %}
      {%- set label = item.data | eventLabel('Active') %}
      <li data-start="{{ item.data.date | isoLondon }}" data-end="{{ item.data | eventEnd | isoLondon }}"><strong>{{ item.data.date | day }}</strong> <a href="{{ item.url | href }}">{{ item.data.title }}</a>{% if label %} <span class="status">{{ label }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
  {%- endfor %}
</section>
{%- endif %}
</div>
{%- endif %}

<section class="home-section" aria-labelledby="home-articles">
  <h2 id="home-articles"><a href="/blog">Latest Blog Articles</a></h2>
  <div class="card-grid">
    {%- set cardFill = '350x300' %}
    {%- asyncEach item in (collections.blog | newestFirst).slice(0, 3) %}
    {% include "partials/card.njk" %}
    {%- endeach %}
  </div>
</section>
