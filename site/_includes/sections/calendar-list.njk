<h1>{{ title }}</h1>
{%- set items = collections.calendar | upcoming %}
{%- if items.length %}
<div class="event-list">
  {%- asyncEach item in items %}
  {% include "partials/card.njk" %}
  {%- endeach %}
</div>
{#- site.js shows this if every card has ended since the last build. #}
<p class="event-empty" hidden>Could not find any events.</p>
{%- else %}
<p>Could not find any events.</p>
{%- endif %}
