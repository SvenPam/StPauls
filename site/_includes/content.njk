---
layout: base.njk
---
{#- ifAsync, not if: a plain if around an include that runs the async picture shortcode drops its output.
    The three dated sections have list and item templates. Anything else that has a permalink is a page. -#}
{%- set dated = section == "blog" or section == "calendar" or section == "notices" -%}
{% ifAsync dated %}{% include "sections/" + section + ("-list" if isIndex else "-item") + ".njk" %}{% endif %}
{%- ifAsync not dated %}{% include "sections/page.njk" %}{% endif %}
