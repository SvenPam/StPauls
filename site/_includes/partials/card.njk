{#- One item in a list, topic page or the home page, from `item`. Lists render it inside asyncEach because blog cards may hold a picture.
    With `cardFill` ('WxH') the image is cropped to that aspect. -#}
{%- set d = item.data -%}
{%- set event = d.section == 'calendar' -%}
<article class="card"{% if event %} data-end="{{ d | eventEnd | isoLondon }}"{% endif %}>
  <h2 class="card__title"><a href="{{ item.url | href }}">{{ d.title }}</a></h2>
  {%- if event %}
  <p class="meta-line"><span class="status">{{ d | eventStatus }}</span> <span class="date-time">{{ d.date | date }} {{ d.date | time }}</span></p>
  {%- elif d.section == 'blog' %}
  <p class="meta-line"><span class="date-time">Published {{ d.date | date }}</span></p>
  {%- endif %}
  {%- if d.location %}
  <p class="card__location">{{ d.location }}</p>
  {%- endif %}
  {%- ifAsync d.section == 'blog' %}{% set imageSrc = d.image %}{% set imageAlt = d.image_alt %}{% set imageFill = cardFill %}{% include "partials/image.njk" %}{% endif %}
  {%- if d.summary %}
  <p class="{% if d.section == 'notices' %}notice-summary{% else %}card__summary{% endif %}">{{ d.summary }}</p>
  {%- endif %}
  {%- set topicSlug = d.topic %}{% set topicSection = d.section %}
  {%- set topicLink %}{% include "partials/topic-link.njk" %}{% endset %}
  {%- if topicLink | trim %}
  <p class="card__topic">{{ topicLink | safe }}</p>
  {%- endif %}
  {%- if d.section == 'blog' %}
  <p><a href="{{ item.url | href }}">Read more<span class="visually-hidden"> about {{ d.title }}</span></a></p>
  {%- endif %}
</article>
