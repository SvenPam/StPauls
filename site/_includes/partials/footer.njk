<footer class="site-footer">
  <div class="container site-footer__inner">
    <nav class="footer-groups" aria-label="Footer">
      {%- for group in collections | footerGroups %}
      <div class="footer-group">
        <h2 class="footer-group__title">{{ group.title }}</h2>
        <ul>
          {%- for link in group.links %}
          <li><a href="{{ link.url }}">{{ link.name }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </nav>
    <section class="find-us" aria-labelledby="find-us">
      <h2 id="find-us" class="footer-group__title">Find Us</h2>
      <a class="find-us__map" href="{{ settings.map_url }}">
        {%- picture { src: 'images/map.png', alt: "Map showing St Paul's Church, Warton", sizes: '(min-width: 768px) 24rem, 100vw' } -%}
      </a>
      <a href="{{ settings.directions_url }}">
        {% include "partials/address.njk" %}
      </a>
      <p><a class="find-us__social" href="{{ settings.facebook_url }}"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>Find us on Facebook</a></p>
    </section>
  </div>
  <div class="container site-footer__legal">
    <p>&copy; {{ build.year }} {{ site.title }}</p>
  </div>
</footer>
