<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == '/' %}{{ site.title }}{% else %}{{ title }} | {{ site.title }}{% endif %}</title>
{#- An item's summary, else the page's own description; a topic page uses its section's. -#}
{%- set metaDescription = summary or description %}
{%- if not metaDescription and t and t.section %}{% set metaDescription = (collections.all | sectionIndex(t.section)).data.description %}{% endif %}
{%- if metaDescription %}
<meta name="description" content="{{ metaDescription }}">
{%- endif %}
{#- Facebook previews, as live: the home page and blog articles only. -#}
{%- if page.url == '/' %}
{%- set shareSrc = (hero_image | assetPath) or hero_image or 'images/hero.jpg' %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ site.title }}">
{%- if metaDescription %}
<meta property="og:description" content="{{ metaDescription }}">
{%- endif %}
<meta property="og:url" content="{{ site.url }}/">
<meta property="og:image" content="{% shareImage shareSrc, site.url %}">
{%- elif section == 'blog' and not isIndex %}
{%- set shareSrc = ({ data: { image: image, image_alt: image_alt }, inputPath: page.inputPath } | cardImage).src %}
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ summary or (collections.all | sectionIndex('blog')).data.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | href }}">
<meta property="og:image" content="{% shareImage shareSrc, site.url %}">
{%- endif %}
{%- if page.url != "/404.html" %}
<link rel="canonical" href="{{ site.url }}{{ page.url | href }}">
{%- endif %}
<meta name="theme-color" content="#002060">
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="{{ assets.css.url }}" integrity="{{ assets.css.integrity }}">
<script src="{{ assets.js.url }}" integrity="{{ assets.js.integrity }}" defer></script>
