---
layout: false
feedSections: [blog, calendar, notices]
pagination:
  data: feedSections
  size: 1
  alias: feedSection
permalink: "/{{ feedSection }}/index.xml"
eleventyExcludeFromCollections: true
---
{#- RSS 2.0 for a section: 20 items, events upcoming only, notices not ended. Autoescape escapes each value once. -#}
{%- set base = site.url -%}
{%- set sectionTitle = "" -%}
{%- for p in collections.all %}{% if p.data.isIndex and p.data.section == feedSection %}{% set sectionTitle = p.data.title %}{% endif %}{% endfor -%}
{%- if feedSection == 'calendar' %}{% set items = collections.calendar | upcoming %}{% elif feedSection == 'notices' %}{% set items = collections.notices | noticesCurrent %}{% else %}{% set items = collections[feedSection] | newestFirst %}{% endif -%}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0">
  <channel>
    <title>{{ sectionTitle }} | {{ site.title }}</title>
    <link>{{ base }}/{{ feedSection }}</link>
    <description>{{ sectionTitle }} from {{ site.title }}</description>
    <language>en-gb</language>
    {%- for item in items %}{% if loop.index <= 20 %}
    <item>
      <title>{{ item.data.title }}</title>
      <link>{{ base }}{{ item.url | href }}</link>
      <guid>{{ base }}{{ item.url | href }}</guid>
      <pubDate>{{ item.data.date | rfc822London }}</pubDate>
      <description>{{ item.data.summary or (item.templateContent | excerpt) }}</description>
    </item>
    {%- endif %}{% endfor %}
  </channel>
</rss>
